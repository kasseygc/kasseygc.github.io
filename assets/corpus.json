---
layout: null
sitemap: false
---
{%- comment -%}
  Plain-text corpus for the concordance (_includes/kwic.html), fetched on the
  first search. Essays first (newest first), then research papers.
{%- endcomment -%}
{%- assign papers = site.portfolio | sort: 'order' -%}
[
{%- for doc in site.posts %}
{"t":{{ doc.title | jsonify }},"u":{{ doc.url | jsonify }},"y":{{ doc.date | date: '%Y' | jsonify }},"k":"essay","x":{{ doc.content | strip_html | normalize_whitespace | jsonify }}},
{%- endfor %}
{%- for doc in papers %}
{"t":{{ doc.title | jsonify }},"u":{{ doc.url | jsonify }},"y":"","k":"paper","x":{{ doc.content | strip_html | normalize_whitespace | default: doc.excerpt | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
